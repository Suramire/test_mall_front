{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "jsx": "preserve",
    "types": ["@dcloudio/types", "wechat-miniprogram"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@mall/*": ["../../packages/*/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
